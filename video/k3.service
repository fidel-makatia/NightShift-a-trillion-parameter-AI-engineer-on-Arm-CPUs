[Unit]
Description=Kimi K3 (2.8T) llama.cpp server — PR #26185 fork, parallel serving
After=network.target data.mount

[Service]
Type=simple
User=nightshift
ExecStart=/bin/bash -lc 'exec /data/llama-k3/build/bin/llama-server \
  --model $(ls /data/models/Kimi-K3-GGUF/UD-IQ1_S/*00001-of-*.gguf) \
  --alias kimi-k3 --host 0.0.0.0 --port 8081 \
  --ctx-size 16384 --parallel 4 --cont-batching \
  --threads 64 --jinja --reasoning-budget 0'
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
